// The game on Cloudflare Workers (npx wrangler dev / npx wrangler deploy).
// The files of public/ are served as they are, without running the Worker, so
// they do not count against the day's request limit; their headers come from
// public/_headers. Only the addresses in run_worker_first reach worker/index.js.
{
  "name": "consequences-game",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // The kit's shared code uses Node's crypto
  "compatibility_flags": ["nodejs_compat"],
  // The kit's files (its scripts, Bootstrap, fonts and public/_headers) are
  // copied into public/ before wrangler serves or uploads it: `npm run build`
  // (packages/room-kit/CLAUDE.md). wrangler runs the command in the folder it
  // was started in - the game's for `npm start` and the browser tests, the
  // root's for Workers Builds - so the game is named, not its path. Workers
  // Builds runs the same copy first, as its own Build command, and `wrangler
  // deploy` then finds the files in place (docs/release.md).
  // `npm start` copies again when a file of the kit changes
  "build": {
    "command": "npm run build -w consequences-game",
    "watch_dir": "../../packages/room-kit/public"
  },
  // `npm start` on its own port: whoami's is 8787, and both games may run side by side
  "dev": { "port": 8788 },
  // No address yet: the game runs only locally until its Custom Domain is
  // named. The browser keeps a player's name, ID and secret per address, so
  // the game will have one address only; workers.dev and the preview
  // addresses of versions are off
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /game, /index and /404 too: the static files would answer them with
    // game.html, index.html and 404.html, where the game answers its 404 page
    "run_worker_first": ["/api/*", "/game/*", "/ws/*", "/game", "/index", "/404"]
  },
  // One room per code (worker/room.js). A new or renamed class of rooms needs
  // a new migration entry; SQLite storage is the kind the free plan has
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // console.log of the Worker goes to Workers Logs in the Cloudflare dashboard
  "observability": { "enabled": true }
}
