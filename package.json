{
  "name": "whoami-game",
  "version": "1.11.1",
  "private": true,
  "description": "Who am I? game for friends and family",
  "homepage": "https://whoami-game.onrender.com/",
  "bugs": {
    "url": "https://github.com/mikhail-e/whoami-game/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhail-e/whoami-game.git"
  },
  "license": "MIT",
  "author": "Mikhail Elychev",
  "main": "worker/index.js",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "test": "npm run lint && jest && playwright test",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "BASE_URL=https://whoami-game.onrender.com playwright test --workers=2",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.1.3",
    "wrangler": "^4.157.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
